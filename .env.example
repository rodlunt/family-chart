# Copy to .env on the deploy host (never commit the real file - this repo is public).
# Powers the /request-access form's "email Rodney" step. Without these set, that form
# fails loudly (500) rather than silently pretending to have sent anything.

RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM=Tree Research <noreply@lunt.au>
MAIL_TO=rod@lunt.au
