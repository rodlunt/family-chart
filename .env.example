# Copy to .env on the deploy host (never commit the real file - this repo is public).
# Powers the /request-access form's "email Rodney" step. Without these set, that form
# fails loudly (500) rather than silently pretending to have sent anything.

RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM=Tree Research <noreply@lunt.au>
MAIL_TO=rod@lunt.au

# Maps each basic_auth username (from the Caddyfile) to the id of their own record in your
# tree data, so "Focus on me" knows who's logged in. One JSON object, no line breaks. Real
# names either side of this mapping never belong in the repo - this is exactly why it's here
# and not in server/index.js.
AUTH_USER_PERSON_IDS_JSON={"someuser":"their-person-id-in-your-tree-data"}
